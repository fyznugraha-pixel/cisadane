datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Visitor {
  id         String   @id @default(uuid())
  full_name  String
  email      String
  phone      String
  domicile   String
  created_at DateTime @default(now())

  @@map("visitors")
}
